# Aplicação
VITE_APP_ID=tripmaster-local
JWT_SECRET=change-me-in-local-dev

# Banco de dados local (sem Docker)
DATABASE_URL=postgresql://tripmaster:tripmaster@localhost:5432/tripmaster

# LLM (Multi-Provider com Fallback Automático)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEYS=

VITE_ANALYTICS_ENDPOINT=http://localhost
VITE_ANALYTICS_WEBSITE_ID=local

OWNER_OPEN_ID=
SMTP_USER=
SMTP_PASS=

# Opcional: ativa testes de integração manuais
RUN_INTEGRATION_TESTS=false